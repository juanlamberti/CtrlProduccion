<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity Ingrediente.
    -->
    <changeSet id="20220414005523-1" author="jhipster">
        <createTable tableName="ingrediente">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="cantidad_ing" type="${floatType}">
                <constraints nullable="false" />
            </column>
            <column name="articulo_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <column name="insumo_id" type="bigint">
                <constraints nullable="false" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->

    <changeSet id="20220414005523-1-sequence" author="jhipster">
        <createSequence sequenceName="ing_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="20220414005523-auditoria" author="jhipster">
        <addColumn tableName="ingrediente">
            <column name="created_by" type="varchar(50)" defaultValue="system">
                <constraints nullable="true"/>
            </column>
            <column name="created_date" type="timestamp" defaultValueDate="${now}">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
            <column name="status" type="varchar(50)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="20261020-clasificar-articulos" author="codex">
        <sql>UPDATE articulo SET naturaleza_art = CASE WHEN EXISTS (SELECT 1 FROM ingrediente i WHERE i.articulo_id = articulo.id) THEN 'COMPUESTO' ELSE 'SIMPLE' END</sql>
    </changeSet>
</databaseChangeLog>
