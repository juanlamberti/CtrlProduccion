<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity TipoParametro.
    -->
    <changeSet id="20260702124129-1" author="jhipster">
        <createTable tableName="tipo_parametro">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="codigo_tp_param" type="varchar(20)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_tipo_parametro__codigo_tp_param" />
            </column>
            <column name="desc_tp_param" type="varchar(300)">
                <constraints nullable="false" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->

    <changeSet id="20260702124129-sequence" author="jhipster">
        <createSequence sequenceName="tp_param_seq" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="20260702124129-auditoria" author="jhipster">
        <addColumn tableName="tipo_parametro">
            <column name="created_by" type="varchar(50)" defaultValue="system">
                <constraints nullable="true"/>
            </column>
            <column name="created_date" type="timestamp" defaultValueDate="${now}">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_by" type="varchar(50)"/>
            <column name="last_modified_date" type="timestamp"/>
            <column name="status" type="varchar(50)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
